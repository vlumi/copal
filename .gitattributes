# Gondwana Life is written and run in Shift_JIS, as Fujitsu NetCOBOL has
# it, and its batch files end their lines as Windows does. The working
# tree holds the bytes the compiler and the programs read; the repository
# stores them as UTF-8, so that diffs and the web read.
gondwana/programs/*.cbl working-tree-encoding=Shift_JIS
gondwana/copybooks/*.cpy working-tree-encoding=Shift_JIS
gondwana/scripts/*.BAT text eol=crlf working-tree-encoding=Shift_JIS
gondwana/testdata/**/*.TXT working-tree-encoding=Shift_JIS
gondwana/testdata/**/*.DAT working-tree-encoding=Shift_JIS
gondwana/testdata/**/*.RPT working-tree-encoding=Shift_JIS
gondwana/testdata/**/*.OUT working-tree-encoding=Shift_JIS
gondwana/testdata/**/*.LOG working-tree-encoding=Shift_JIS
