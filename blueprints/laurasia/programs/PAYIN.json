      "name": "APPLY-PAYMENT",
      "section": "APPLY-PAYMENT",
      "description": "the payment off the balance; one that covers the last statement, or clears the balance, pays the statement in full.",
      "source": "laurasia/programs/payin.cbl:129",
      "performedBy": [
        "APPLY-RECORD"
      ],
