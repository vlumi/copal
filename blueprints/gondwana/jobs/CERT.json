{
  "job": "CERT",
  "kind": "script",
  "source": "gondwana/scripts/CERT.BAT",
  "description": [
    "CERT.BAT: 保険料控除証明書。年に一度、10月の最初の営業日の日次",
    "処理の後に、その年に収納した保険料の証明書を作り、印刷会社に渡す。",
    "",
    "使い方: CERT.BAT YYYYMMDD  業務日付。その年の1月からこの日まで。",
    "環境: GLS_BIN プログラム、GLS_DATA データ",
    "",
    "変更履歴",
    "2026-11-19 YN  GL-0827 初版。"
  ],
  "steps": [
    {
      "step": "GLY030",
      "program": "GLY030",
      "arguments": [
        "$DATE"
      ],
      "stopsIf": "RC \u003e= 8",
      "description": [
        "保険料控除証明書"
      ],
      "source": "gondwana/scripts/CERT.BAT:22",
      "dds": [
        {
          "dd": "PRMHST",
          "datasets": [
            "$DATA/MASTER/PRMHST.IDX"
          ],
          "indexed": true,
          "file": "PRMHST-F",
          "uses": [
            "read"
          ],
          "copybook": "PRMHST",
          "source": "gondwana/scripts/CERT.BAT:22"
        },
        {
          "dd": "POLMST",
          "datasets": [
            "$DATA/MASTER/POLMST.IDX"
          ],
          "indexed": true,
          "file": "POLMST-F",
          "uses": [
            "read"
          ],
          "copybook": "POLMST",
          "source": "gondwana/scripts/CERT.BAT:22"
        },
        {
          "dd": "PRODTB",
          "datasets": [
            "$DATA/MASTER/PRODTB.TXT"
          ],
          "file": "PRODTB-F",
          "uses": [
            "read"
          ],
          "copybook": "PRODTB",
          "source": "gondwana/scripts/CERT.BAT:22"
        },
        {
          "dd": "PRMCERT",
          "datasets": [
            "$DATA/OUT/PRMCERT.$DATE.TXT"
          ],
          "file": "PRMCERT-F",
          "uses": [
            "write"
          ],
          "copybook": "PRMCERT",
          "source": "gondwana/scripts/CERT.BAT:22"
        },
        {
          "dd": "GLY030R",
          "datasets": [
            "$DATA/RPT/GLY030.$DATE.RPT"
          ],
          "file": "REPORT-F",
          "uses": [
            "write"
          ],
          "source": "gondwana/scripts/CERT.BAT:22"
        },
        {
          "dd": "stdout",
          "datasets": [
            "$DATA/RPT/GLY030.$DATE.OUT"
          ],
          "uses": [
            "write"
          ],
          "source": "gondwana/scripts/CERT.BAT:22"
        }
      ]
    }
  ],
  "datasets": [
    {
      "dataset": "$DATA/MASTER/PRMHST.IDX",
      "copybook": "PRMHST",
      "kind": "internal",
      "indexed": true,
      "readBy": [
        "GLY030"
      ]
    },
    {
      "dataset": "$DATA/MASTER/POLMST.IDX",
      "copybook": "POLMST",
      "kind": "internal",
      "indexed": true,
      "readBy": [
        "GLY030"
      ]
    },
    {
      "dataset": "$DATA/MASTER/PRODTB.TXT",
      "copybook": "PRODTB",
      "kind": "external",
      "readBy": [
        "GLY030"
      ]
    },
    {
      "dataset": "$DATA/OUT/PRMCERT.$DATE.TXT",
      "copybook": "PRMCERT",
      "kind": "output",
      "writtenBy": [
        "GLY030"
      ]
    },
    {
      "dataset": "$DATA/RPT/GLY030.$DATE.RPT",
      "kind": "output",
      "writtenBy": [
        "GLY030"
      ]
    },
    {
      "dataset": "$DATA/RPT/GLY030.$DATE.OUT",
      "kind": "output",
      "writtenBy": [
        "GLY030"
      ]
    }
  ]
}
