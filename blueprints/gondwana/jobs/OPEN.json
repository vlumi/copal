{
  "job": "OPEN",
  "kind": "script",
  "source": "gondwana/scripts/OPEN.BAT",
  "description": [
    "OPEN.BAT: システム開設。契約抽出ファイルと保障抽出ファイルから",
    "契約マスタと保障マスタの索引ファイル、制御レコードを作る。一度",
    "だけ実行する。",
    "",
    "使い方: OPEN.BAT YYYYMMDD  業務日付",
    "環境: GLS_BIN プログラム、GLS_SCRIPTS バッチファイル、GLS_DATA データ",
    "",
    "変更履歴",
    "1999-11-08 MS  GL-0233 初版、PC システム移行時。",
    "2026-11-18 YN  GL-0825 保障マスタ。"
  ],
  "steps": [
    {
      "step": "GLO010",
      "program": "GLO010",
      "arguments": [
        "$DATE"
      ],
      "stopsIf": "RC \u003e= 8",
      "description": [
        "契約マスタの初期登録と制御レコード"
      ],
      "source": "gondwana/scripts/OPEN.BAT:29",
      "dds": [
        {
          "dd": "EXTRACT",
          "datasets": [
            "$DATA/IN/EXTRACT.TXT"
          ],
          "file": "EXTRACT-F",
          "uses": [
            "read"
          ],
          "copybook": "POLMST",
          "source": "gondwana/scripts/OPEN.BAT:29"
        },
        {
          "dd": "POLMST",
          "datasets": [
            "$DATA/MASTER/POLMST.IDX"
          ],
          "indexed": true,
          "file": "POLMST-F",
          "uses": [
            "write",
            "read"
          ],
          "copybook": "POLMST",
          "source": "gondwana/scripts/OPEN.BAT:29"
        },
        {
          "dd": "COVEXT",
          "datasets": [
            "$DATA/IN/COVEXT.TXT"
          ],
          "file": "COVEXT-F",
          "uses": [
            "read"
          ],
          "copybook": "COVMST",
          "source": "gondwana/scripts/OPEN.BAT:29"
        },
        {
          "dd": "COVMST",
          "datasets": [
            "$DATA/MASTER/COVMST.IDX"
          ],
          "indexed": true,
          "file": "COVMST-F",
          "uses": [
            "write"
          ],
          "copybook": "COVMST",
          "source": "gondwana/scripts/OPEN.BAT:29"
        },
        {
          "dd": "GLSCTL",
          "datasets": [
            "$DATA/MASTER/GLSCTL.BIN"
          ],
          "file": "GLSCTL-F",
          "uses": [
            "write"
          ],
          "copybook": "CTLREC",
          "source": "gondwana/scripts/OPEN.BAT:29"
        },
        {
          "dd": "GLO010R",
          "datasets": [
            "$DATA/RPT/GLO010.$DATE.RPT"
          ],
          "file": "REPORT-F",
          "uses": [
            "write"
          ],
          "source": "gondwana/scripts/OPEN.BAT:29"
        },
        {
          "dd": "stdout",
          "datasets": [
            "$DATA/RPT/GLO010.$DATE.OUT"
          ],
          "uses": [
            "write"
          ],
          "source": "gondwana/scripts/OPEN.BAT:29"
        }
      ]
    }
  ],
  "datasets": [
    {
      "dataset": "$DATA/IN/EXTRACT.TXT",
      "copybook": "POLMST",
      "kind": "external",
      "readBy": [
        "GLO010"
      ]
    },
    {
      "dataset": "$DATA/MASTER/POLMST.IDX",
      "copybook": "POLMST",
      "kind": "internal",
      "indexed": true,
      "writtenBy": [
        "GLO010"
      ],
      "readBy": [
        "GLO010"
      ]
    },
    {
      "dataset": "$DATA/IN/COVEXT.TXT",
      "copybook": "COVMST",
      "kind": "external",
      "readBy": [
        "GLO010"
      ]
    },
    {
      "dataset": "$DATA/MASTER/COVMST.IDX",
      "copybook": "COVMST",
      "kind": "internal",
      "indexed": true,
      "writtenBy": [
        "GLO010"
      ]
    },
    {
      "dataset": "$DATA/MASTER/GLSCTL.BIN",
      "copybook": "CTLREC",
      "kind": "internal",
      "writtenBy": [
        "GLO010"
      ]
    },
    {
      "dataset": "$DATA/RPT/GLO010.$DATE.RPT",
      "kind": "output",
      "writtenBy": [
        "GLO010"
      ]
    },
    {
      "dataset": "$DATA/RPT/GLO010.$DATE.OUT",
      "kind": "output",
      "writtenBy": [
        "GLO010"
      ]
    }
  ]
}
