      "source": "pangaea/programs/CARDLOAD.cbl:92",
      "conditions": [
        "WS-FILE-STATUSES = ALL '0'",
        "READ CONTROL-FILE AT END"
      ],
      "actions": [
        "OPEN INPUT CONTROL-FILE CARD-IN OUTPUT ONLINE-OUT REPORT-OUT",
        "DISPLAY 'CARDLOAD: CANNOT OPEN FILES ' WS-FILE-STATUSES",
        "MOVE 16 TO RETURN-CODE",
        "STOP RUN",
        "READ CONTROL-FILE",
        "MOVE 'NO BANK CONTROL RECORD' TO WS-ABORT-MESSAGE",
