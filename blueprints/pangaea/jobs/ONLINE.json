        "AUTH"
      ],
      "readBy": [
        "AUTH"
      ]
    },
    {
      "dataset": "HOLD.ONLINE(0)",
      "copybook": "HOLDREC",
      "writtenBy": [
        "AUTH"
      ],
      "readBy": [
        "AUTH"
      ]
    }
  ]
}
