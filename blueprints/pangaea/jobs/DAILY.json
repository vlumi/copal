{
  "job": "DAILY",
  "source": "pangaea/jobs/DAILY.jcl",
  "description": [
    "DAILY BATCH: VALIDATE THE DAY'S TRANSACTIONS, ACCRUE INTEREST",
    "AND POST WHAT A CLOSED MONTH OWES, THEN SORT AND POST THE",
    "DAY'S TRANSACTIONS, THE TRANSFER CREDITS AND RETURNS THEY LEAD",
    "TO, APPLY THE DAY'S ACCOUNT MAINTENANCE, AND MOVE TO THE NEXT",
    "BUSINESS DAY.",
    "",
    "READS   BANK.CONTROL(0)  ACCT.MASTER(0)  TRAN.DAILY(0)",
    "        ACCT.ACCRUAL(0)  ACCT.MAINT(0)    BANK.RATES",
    "WRITES  BANK.CONTROL(+1) ACCT.MASTER(+1) ACCT.ACCRUAL(+1)",
    "        TRAN.AUDIT(+1)   TRAN.REJECTS(+1) MAINT.REJECTS(+1)",
    "",
    "A STEP RUNS ONLY IF NO EARLIER STEP ENDED WITH RC ABOVE 4, SO",
    "A RUN THAT FAILS LEAVES THE BUSINESS DATE WHERE IT WAS."
  ],
  "steps": [
    {
      "step": "VALID",
      "program": "TXVALID",
      "description": [
        "VALIDATE THE DAY'S TRANSACTION FILE"
      ],
      "source": "pangaea/jobs/DAILY.jcl:20",
      "dds": [
        {
          "dd": "BANKCTL",
          "datasets": [
            "BANK.CONTROL(0)"
          ],
          "disp": "SHR",
          "file": "CONTROL-FILE",
          "use": "read",
          "source": "pangaea/jobs/DAILY.jcl:21"
        },
        {
          "dd": "TRANIN",
          "datasets": [
            "TRAN.DAILY(0)"
          ],
          "disp": "SHR",
          "file": "TRAN-IN",
          "use": "read",
          "source": "pangaea/jobs/DAILY.jcl:22"
        },
        {
          "dd": "TRANOUT",
          "datasets": [
            "\u0026\u0026VALID"
          ],
          "disp": "NEW",
          "file": "TRAN-OUT",
          "use": "write",
          "source": "pangaea/jobs/DAILY.jcl:23"
        },
        {
          "dd": "REJECTS",
          "datasets": [
            "TRAN.REJECTS(+1)"
          ],
          "disp": "NEW",
          "file": "REJECT-OUT",
          "use": "write",
          "source": "pangaea/jobs/DAILY.jcl:25"
        },
        {
          "dd": "VALRPT",
          "sysout": true,
          "file": "REPORT-OUT",
          "use": "write",
          "source": "pangaea/jobs/DAILY.jcl:27"
        }
      ]
    },
    {
      "step": "ACCRUE",
      "program": "INTACCR",
      "cond": "(4,LT)",
      "description": [
        "ACCRUE INTEREST UP TO TODAY ON THE OPENING BALANCES. WHEN A",
        "MONTH HAS CLOSED, POST ITS INTEREST AND FEES. THE CHARGES COME",
        "IN MASTER ORDER, SO THEY ARE POSTED WITHOUT A SORT."
      ],
      "source": "pangaea/jobs/DAILY.jcl:33",
      "dds": [
        {
          "dd": "BANKCTL",
          "datasets": [
            "BANK.CONTROL(0)"
          ],
          "disp": "SHR",
          "file": "CONTROL-FILE",
          "use": "read",
          "source": "pangaea/jobs/DAILY.jcl:34"
        },
        {
          "dd": "RATES",
          "datasets": [
            "BANK.RATES"
          ],
          "disp": "SHR",
          "file": "RATE-FILE",
          "use": "read",
          "source": "pangaea/jobs/DAILY.jcl:35"
        },
        {
          "dd": "ACCTIN",
          "datasets": [
            "ACCT.MASTER(0)"
          ],
          "disp": "SHR",
          "file": "ACCT-IN",
          "use": "read",
          "source": "pangaea/jobs/DAILY.jcl:36"
        },
        {
          "dd": "ACCRIN",
          "datasets": [
            "ACCT.ACCRUAL(0)"
          ],
          "disp": "SHR",
          "file": "ACCR-IN",
          "use": "read",
          "source": "pangaea/jobs/DAILY.jcl:37"
        },
        {
          "dd": "ACCROUT",
          "datasets": [
            "ACCT.ACCRUAL(+1)"
          ],
          "disp": "NEW",
          "file": "ACCR-OUT",
          "use": "write",
          "source": "pangaea/jobs/DAILY.jcl:38"
        },
        {
          "dd": "ACCRRPT",
          "sysout": true,
          "file": "REPORT-OUT",
          "use": "write",
          "source": "pangaea/jobs/DAILY.jcl:40"
        }
      ]
    },
    {
      "step": "CHARGE",
      "program": "MONCHG",
