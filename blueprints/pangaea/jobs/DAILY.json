          "datasets": [
            "\u0026\u0026MONTHLY"
          ],
          "disp": "NEW",
          "file": "TRAN-OUT",
          "use": "write",
          "source": "pangaea/jobs/DAILY.jcl:45"
        },
        {
          "dd": "MONRPT",
          "sysout": true,
          "file": "REPORT-OUT",
          "use": "write",
          "source": "pangaea/jobs/DAILY.jcl:47"
        }
      ]
    },
