        },
        {
          "dd": "TRANOUT",
          "datasets": [
            "\u0026\u0026VALID"
          ],
          "disp": "NEW",
          "file": "TRAN-OUT",
          "uses": [
            "write"
          ],
          "copybook": "TRANREC",
