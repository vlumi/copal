  "paragraphs": [
    {
      "name": "0000-MAIN",
      "description": "ACCRUE EVERY ACCOUNT, THEN REPORT.",
      "source": "pangaea/programs/INTACCR.cbl:146",
      "performs": [
        {
          "target": "1000-INITIALIZE",
          "source": "pangaea/programs/INTACCR.cbl:147"
        },
        {
          "target": "2000-ACCRUE-ACCOUNT",
          "source": "pangaea/programs/INTACCR.cbl:148"
        },
        {
          "target": "8000-WRITE-REPORT",
          "source": "pangaea/programs/INTACCR.cbl:150"
        },
        {
          "target": "9000-CLOSE-FILES",
          "source": "pangaea/programs/INTACCR.cbl:151"
        }
      ]
    },
    {
      "name": "1000-INITIALIZE",
      "description": "OPEN THE FILES, LOAD THE RATES AND READ THE FIRST ACCOUNT.",
      "source": "pangaea/programs/INTACCR.cbl:156",
      "performs": [
        {
          "target": "9900-ABORT",
          "source": "pangaea/programs/INTACCR.cbl:167"
        },
        {
          "target": "1100-LOAD-RATES",
          "source": "pangaea/programs/INTACCR.cbl:171"
        },
        {
          "target": "1200-READ-ACCOUNT",
          "source": "pangaea/programs/INTACCR.cbl:172"
        }
      ],
      "performedBy": [
        "0000-MAIN"
      ]
    },
    {
      "name": "1100-LOAD-RATES",
      "description": "READ THE RATE FILE INTO THE RATE TABLE.",
      "source": "pangaea/programs/INTACCR.cbl:175",
      "performs": [
        {
          "target": "9900-ABORT",
          "source": "pangaea/programs/INTACCR.cbl:180"
        },
        {
          "target": "9900-ABORT",
          "source": "pangaea/programs/INTACCR.cbl:191"
        }
      ],
      "performedBy": [
        "1000-INITIALIZE"
      ]
    },
    {
      "name": "1200-READ-ACCOUNT",
      "description": "READ THE NEXT ACCOUNT AND ITS ACCRUAL, WHICH MUST MATCH.",
      "source": "pangaea/programs/INTACCR.cbl:195",
      "performs": [
        {
          "target": "9900-ABORT",
          "source": "pangaea/programs/INTACCR.cbl:211"
        }
      ],
      "performedBy": [
        "1000-INITIALIZE",
        "2000-ACCRUE-ACCOUNT"
      ]
    },
    {
      "name": "2000-ACCRUE-ACCOUNT",
      "description": "ACCRUE ONE ACCOUNT UP TO THE BUSINESS DATE. IF A MONTH CLOSED ON THE WAY, ACCRUE ITS DAYS FIRST AND MAKE ITS INTEREST DUE.",
      "source": "pangaea/programs/INTACCR.cbl:217",
      "performs": [
        {
          "target": "2100-FIND-RATE",
          "source": "pangaea/programs/INTACCR.cbl:218"
        },
        {
          "target": "2200-FIND-MONTH-START",
          "source": "pangaea/programs/INTACCR.cbl:222"
        },
        {
          "target": "2300-ACCRUE-DAYS",
          "source": "pangaea/programs/INTACCR.cbl:225"
        },
        {
          "target": "2400-CLOSE-MONTH",
          "source": "pangaea/programs/INTACCR.cbl:226"
        },
        {
          "target": "2300-ACCRUE-DAYS",
          "source": "pangaea/programs/INTACCR.cbl:230"
        },
        {
          "target": "1200-READ-ACCOUNT",
          "source": "pangaea/programs/INTACCR.cbl:234"
        }
      ],
      "performedBy": [
        "0000-MAIN"
      ]
    },
    {
      "name": "2100-FIND-RATE",
      "description": "FIND THE ACCOUNT'S RATE: BELOW ZERO THE DEBIT RATE OF ITS TYPE, OTHERWISE THE CREDIT RATE OF THE HIGHEST TIER IT REACHES.",
      "source": "pangaea/programs/INTACCR.cbl:238",
      "performs": [
        {
          "target": "2110-TAKE-RATE",
          "source": "pangaea/programs/INTACCR.cbl:245"
        },
        {
          "target": "2110-TAKE-RATE",
          "source": "pangaea/programs/INTACCR.cbl:252"
        },
        {
          "target": "9900-ABORT",
          "source": "pangaea/programs/INTACCR.cbl:259"
        }
      ],
      "performedBy": [
        "2000-ACCRUE-ACCOUNT"
      ]
    },
    {
      "name": "2110-TAKE-RATE",
      "description": "TAKE THE RATE IN HAND AS THE ACCOUNT'S, SO FAR.",
      "source": "pangaea/programs/INTACCR.cbl:263",
      "performedBy": [
        "2100-FIND-RATE"
      ]
    },
    {
      "name": "2200-FIND-MONTH-START",
      "description": "THE FIRST DAY OF THE MONTH AFTER THE THROUGH DATE.",
      "source": "pangaea/programs/INTACCR.cbl:269",
      "performedBy": [
        "2000-ACCRUE-ACCOUNT"
      ]
    },
    {
      "name": "2300-ACCRUE-DAYS",
      "description": "ACCRUE THE OPENING BALANCE AT THE ACCOUNT'S RATE FOR THE DAYS.",
      "source": "pangaea/programs/INTACCR.cbl:283",
      "performedBy": [
        "2000-ACCRUE-ACCOUNT"
      ]
    },
    {
      "name": "2400-CLOSE-MONTH",
      "description": "MAKE THE CLOSED MONTH'S INTEREST DUE, TO THE CENT, AND KEEP THE FRACTION ACCRUED.",
      "source": "pangaea/programs/INTACCR.cbl:298",
      "performedBy": [
        "2000-ACCRUE-ACCOUNT"
      ]
    },
    {
      "name": "8000-WRITE-REPORT",
      "description": "WRITE THE ACCRUAL REPORT.",
      "source": "pangaea/programs/INTACCR.cbl:312",
      "performedBy": [
        "0000-MAIN"
      ]
    },
    {
      "name": "9000-CLOSE-FILES",
      "description": "CLOSE ALL FILES.",
      "source": "pangaea/programs/INTACCR.cbl:351",
      "performedBy": [
        "0000-MAIN",
        "9900-ABORT"
      ]
    },
    {
      "name": "9900-ABORT",
      "description": "STOP THE RUN WITH RETURN CODE 16, SAYING WHY.",
      "source": "pangaea/programs/INTACCR.cbl:356",
      "performs": [
        {
          "target": "9000-CLOSE-FILES",
          "source": "pangaea/programs/INTACCR.cbl:358"
        }
      ],
      "performedBy": [
        "1000-INITIALIZE",
        "1100-LOAD-RATES",
        "1200-READ-ACCOUNT",
        "2100-FIND-RATE"
      ]
    }
  ]
}
