  "paragraphs": [
    {
      "name": "0000-MAIN",
      "description": "CHARGE EVERY ACCOUNT, THEN REPORT.",
      "source": "pangaea/programs/MONCHG.cbl:111",
      "performs": [
        {
          "target": "1000-INITIALIZE",
          "source": "pangaea/programs/MONCHG.cbl:112"
        },
        {
          "target": "2000-CHARGE-ACCOUNT",
          "source": "pangaea/programs/MONCHG.cbl:113"
        },
        {
          "target": "8000-WRITE-REPORT",
          "source": "pangaea/programs/MONCHG.cbl:115"
        },
        {
          "target": "9000-CLOSE-FILES",
          "source": "pangaea/programs/MONCHG.cbl:116"
        }
      ]
    },
    {
      "name": "1000-INITIALIZE",
      "description": "OPEN THE FILES AND READ THE FIRST ACCOUNT. THE TRANSACTION RECORD STARTS BLANK: NO COUNTER ACCOUNT.",
      "source": "pangaea/programs/MONCHG.cbl:122",
      "performs": [
        {
          "target": "9900-ABORT",
          "source": "pangaea/programs/MONCHG.cbl:133"
        },
        {
          "target": "1200-READ-ACCOUNT",
          "source": "pangaea/programs/MONCHG.cbl:137"
        }
      ],
      "performedBy": [
        "0000-MAIN"
      ]
    },
    {
      "name": "1200-READ-ACCOUNT",
      "description": "READ THE NEXT ACCOUNT AND ITS ACCRUAL, WHICH MUST MATCH.",
      "source": "pangaea/programs/MONCHG.cbl:140",
      "performs": [
        {
          "target": "9900-ABORT",
          "source": "pangaea/programs/MONCHG.cbl:156"
        }
      ],
      "performedBy": [
        "1000-INITIALIZE",
        "2000-CHARGE-ACCOUNT"
      ]
    },
    {
      "name": "2000-CHARGE-ACCOUNT",
      "description": "WRITE AN ACCOUNT'S INTEREST AND FEE, IF ITS MONTH CLOSED.",
      "source": "pangaea/programs/MONCHG.cbl:161",
      "performs": [
        {
          "target": "2100-SETTLE-INTEREST",
          "source": "pangaea/programs/MONCHG.cbl:165"
        },
        {
          "target": "2200-CHARGE-FEE",
          "source": "pangaea/programs/MONCHG.cbl:166"
        },
        {
          "target": "1200-READ-ACCOUNT",
          "source": "pangaea/programs/MONCHG.cbl:168"
        }
      ],
      "performedBy": [
        "0000-MAIN"
      ]
    },
    {
      "name": "2100-SETTLE-INTEREST",
      "description": "CREDIT THE INTEREST DUE, OR CHARGE IT IF THE ACCOUNT WAS OVERDRAWN.",
      "source": "pangaea/programs/MONCHG.cbl:172",
      "performs": [
        {
          "target": "2900-WRITE-TRAN",
          "source": "pangaea/programs/MONCHG.cbl:178"
        },
        {
          "target": "2900-WRITE-TRAN",
          "source": "pangaea/programs/MONCHG.cbl:185"
        }
      ],
      "performedBy": [
        "2000-CHARGE-ACCOUNT"
      ]
    },
    {
      "name": "2200-CHARGE-FEE",
      "description": "CHARGE THE MAINTENANCE FEE: OPEN CURRENT ACCOUNTS ONLY, AND NOT IF THE MONTH CLOSED AT OR ABOVE THE WAIVER BALANCE.",
      "source": "pangaea/programs/MONCHG.cbl:194",
      "performs": [
        {
          "target": "2900-WRITE-TRAN",
          "source": "pangaea/programs/MONCHG.cbl:201"
        }
      ],
      "performedBy": [
        "2000-CHARGE-ACCOUNT"
      ]
    },
    {
      "name": "2900-WRITE-TRAN",
      "description": "WRITE THE TRANSACTION FOR THE ACCOUNT, WITH THE NEXT ID.",
      "source": "pangaea/programs/MONCHG.cbl:212",
      "performedBy": [
        "2100-SETTLE-INTEREST",
        "2200-CHARGE-FEE"
      ]
    },
    {
      "name": "8000-WRITE-REPORT",
      "description": "WRITE THE MONTH-END CHARGES REPORT.",
      "source": "pangaea/programs/MONCHG.cbl:220",
      "performedBy": [
        "0000-MAIN"
      ]
    },
    {
      "name": "9000-CLOSE-FILES",
      "description": "CLOSE ALL FILES.",
      "source": "pangaea/programs/MONCHG.cbl:262",
      "performedBy": [
        "0000-MAIN",
        "9900-ABORT"
      ]
    },
    {
      "name": "9900-ABORT",
      "description": "STOP THE RUN WITH RETURN CODE 16, SAYING WHY.",
      "source": "pangaea/programs/MONCHG.cbl:266",
      "performs": [
        {
          "target": "9000-CLOSE-FILES",
          "source": "pangaea/programs/MONCHG.cbl:268"
        }
      ],
      "performedBy": [
        "1000-INITIALIZE",
        "1200-READ-ACCOUNT"
      ]
    }
  ]
}
