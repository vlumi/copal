  "paragraphs": [
    {
      "name": "0000-MAIN",
      "description": "FIND THE MONTH THAT CLOSED, IF ONE DID, POST ITS POSTINGS TO THE LEDGER AND WRITE THE SUMMARY.",
      "source": "pangaea/programs/GLSUM.cbl:156",
