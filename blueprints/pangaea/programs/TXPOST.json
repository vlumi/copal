  "paragraphs": [
    {
      "name": "0000-MAIN",
      "description": "MATCH UNTIL BOTH FILES END, THEN RECONCILE AND REPORT.",
      "source": "pangaea/programs/TXPOST.cbl:153",
      "performs": [
        {
          "target": "1000-INITIALIZE",
          "source": "pangaea/programs/TXPOST.cbl:154"
        },
        {
          "target": "2000-MATCH",
          "source": "pangaea/programs/TXPOST.cbl:155"
        },
        {
          "target": "5000-RECONCILE",
          "source": "pangaea/programs/TXPOST.cbl:158"
        },
        {
          "target": "8000-WRITE-REPORT",
          "source": "pangaea/programs/TXPOST.cbl:159"
        },
        {
          "target": "9000-CLOSE-FILES",
          "source": "pangaea/programs/TXPOST.cbl:160"
        }
      ]
    },
    {
      "name": "1000-INITIALIZE",
      "description": "OPEN THE FILES AND READ THE FIRST RECORD OF EACH. THE AUDIT TRAIL AND THE REJECTS ARE EXTENDED, AND CREATED IF NEW.",
      "source": "pangaea/programs/TXPOST.cbl:170",
      "performs": [
        {
          "target": "9900-ABORT",
          "source": "pangaea/programs/TXPOST.cbl:189"
        },
        {
          "target": "1200-READ-MASTER",
          "source": "pangaea/programs/TXPOST.cbl:193"
        },
        {
          "target": "1300-READ-TRAN",
          "source": "pangaea/programs/TXPOST.cbl:194"
        }
      ],
      "performedBy": [
        "0000-MAIN"
      ]
    },
    {
      "name": "1200-READ-MASTER",
      "description": "READ THE NEXT OLD MASTER RECORD, CHECKING ACCOUNT ORDER.",
      "source": "pangaea/programs/TXPOST.cbl:197",
      "performs": [
        {
          "target": "9900-ABORT",
          "source": "pangaea/programs/TXPOST.cbl:206"
        }
      ],
      "performedBy": [
        "1000-INITIALIZE",
        "2000-MATCH"
      ]
    },
    {
      "name": "1300-READ-TRAN",
      "description": "READ THE NEXT TRANSACTION, CHECKING ITS ORDER.",
      "source": "pangaea/programs/TXPOST.cbl:214",
      "performs": [
        {
          "target": "9900-ABORT",
          "source": "pangaea/programs/TXPOST.cbl:224"
        }
      ],
      "performedBy": [
        "1000-INITIALIZE",
        "2000-MATCH"
      ]
    },
    {
      "name": "2000-MATCH",
      "description": "ONE STEP OF THE MATCH, BY WHICHEVER KEY IS LOWER: REJECT A TRANSACTION FOR A MISSING ACCOUNT, APPLY ONE TO ITS ACCOUNT, OR WRITE A FINISHED ACCOUNT.",
      "source": "pangaea/programs/TXPOST.cbl:232",
      "performs": [
        {
          "target": "3900-REJECT-TRAN",
          "source": "pangaea/programs/TXPOST.cbl:236"
        },
        {
          "target": "1300-READ-TRAN",
          "source": "pangaea/programs/TXPOST.cbl:237"
        },
