  "paragraphs": [
    {
      "name": "0000-MAIN",
      "description": "MATCH UNTIL BOTH FILES END, THEN RECONCILE AND REPORT.",
      "source": "pangaea/programs/TXPOST.cbl:131",
      "performs": [
        {
          "target": "1000-INITIALIZE",
          "source": "pangaea/programs/TXPOST.cbl:132"
        },
        {
          "target": "2000-MATCH",
          "source": "pangaea/programs/TXPOST.cbl:133"
        },
        {
          "target": "5000-RECONCILE",
          "source": "pangaea/programs/TXPOST.cbl:136"
        },
        {
          "target": "8000-WRITE-REPORT",
          "source": "pangaea/programs/TXPOST.cbl:137"
        },
        {
          "target": "9000-CLOSE-FILES",
          "source": "pangaea/programs/TXPOST.cbl:138"
        }
      ]
    },
    {
      "name": "1000-INITIALIZE",
      "description": "OPEN THE FILES AND READ THE FIRST RECORD OF EACH.",
      "source": "pangaea/programs/TXPOST.cbl:147",
      "performs": [
        {
          "target": "9900-ABORT",
          "source": "pangaea/programs/TXPOST.cbl:164"
        },
        {
          "target": "1200-READ-MASTER",
          "source": "pangaea/programs/TXPOST.cbl:168"
        },
        {
          "target": "1300-READ-TRAN",
          "source": "pangaea/programs/TXPOST.cbl:169"
        }
      ],
      "performedBy": [
        "0000-MAIN"
      ]
    },
    {
      "name": "1200-READ-MASTER",
      "description": "READ THE NEXT OLD MASTER RECORD, CHECKING ACCOUNT ORDER.",
      "source": "pangaea/programs/TXPOST.cbl:172",
      "performs": [
        {
          "target": "9900-ABORT",
          "source": "pangaea/programs/TXPOST.cbl:181"
        }
      ],
      "performedBy": [
        "1000-INITIALIZE",
        "2000-MATCH"
      ]
    },
    {
      "name": "1300-READ-TRAN",
      "description": "READ THE NEXT TRANSACTION, CHECKING ITS ORDER.",
      "source": "pangaea/programs/TXPOST.cbl:189",
      "performs": [
        {
          "target": "9900-ABORT",
          "source": "pangaea/programs/TXPOST.cbl:199"
        }
      ],
      "performedBy": [
        "1000-INITIALIZE",
        "2000-MATCH"
      ]
    },
    {
      "name": "2000-MATCH",
      "description": "ONE STEP OF THE MATCH, BY WHICHEVER KEY IS LOWER: REJECT A TRANSACTION FOR A MISSING ACCOUNT, APPLY ONE TO ITS ACCOUNT, OR WRITE A FINISHED ACCOUNT.",
      "source": "pangaea/programs/TXPOST.cbl:207",
      "performs": [
        {
          "target": "3900-REJECT-TRAN",
          "source": "pangaea/programs/TXPOST.cbl:211"
        },
        {
          "target": "1300-READ-TRAN",
          "source": "pangaea/programs/TXPOST.cbl:212"
        },
        {
          "target": "3000-APPLY-TRAN",
          "source": "pangaea/programs/TXPOST.cbl:214"
        },
        {
          "target": "1300-READ-TRAN",
          "source": "pangaea/programs/TXPOST.cbl:215"
        },
        {
          "target": "4000-WRITE-MASTER",
          "source": "pangaea/programs/TXPOST.cbl:217"
        },
        {
          "target": "1200-READ-MASTER",
          "source": "pangaea/programs/TXPOST.cbl:218"
        }
      ],
      "performedBy": [
        "0000-MAIN"
      ]
    },
    {
      "name": "3000-APPLY-TRAN",
      "description": "APPLY ONE TRANSACTION TO ITS ACCOUNT BY THE POSTING RULES.",
      "source": "pangaea/programs/TXPOST.cbl:222",
      "performs": [
        {
          "target": "3900-REJECT-TRAN",
          "source": "pangaea/programs/TXPOST.cbl:227"
        },
        {
          "target": "3100-POST-DEPOSIT",
          "source": "pangaea/programs/TXPOST.cbl:229"
        },
        {
          "target": "3300-POST-FEE",
          "source": "pangaea/programs/TXPOST.cbl:231"
        },
        {
          "target": "3900-REJECT-TRAN",
          "source": "pangaea/programs/TXPOST.cbl:234"
        },
        {
          "target": "3200-POST-WITHDRAWAL",
