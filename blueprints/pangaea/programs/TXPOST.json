      ]
    },
    {
      "name": "3000-APPLY-TRAN",
      "description": "APPLY ONE TRANSACTION TO ITS ACCOUNT BY THE POSTING RULES.",
      "source": "pangaea/programs/TXPOST.cbl:247",
      "performs": [
