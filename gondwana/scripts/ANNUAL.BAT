@echo off
rem ANNUAL.BAT: 年次処理。年度末 (3月31日) の月次締めの後に、契約者
rem 配当の割り当てと、ご契約内容のお知らせ。
rem
rem 使い方: ANNUAL.BAT YYYYMMDD  年度末の業務日付
rem 環境: GLS_BIN プログラム、GLS_DATA データ
rem
rem 変更履歴
rem 1999-11-08 MS  GL-0233 初版、PC システム移行時 (旧 JCL から)。
rem 2026-11-19 YN  GL-0827 ご契約内容のお知らせ。
rem 2026-11-19 YN  GL-0828 日計表。
setlocal
set DATE=%1
set BIN=%GLS_BIN%
set DATA=%GLS_DATA%
set LOG=%DATA%¥LOG¥ANNUAL.%DATE%.LOG

rem STEP GLY010: 契約者配当
set DD_POLMST=%DATA%¥MASTER¥POLMST.IDX
set DD_GLSCTL=%DATA%¥MASTER¥GLSCTL.BIN
set DD_PRODTB=%DATA%¥MASTER¥PRODTB.TXT
set DD_GLJRNL=%DATA%¥OUT¥GLJRNL.%DATE%.TXT
set DD_GLY010R=%DATA%¥RPT¥GLY010.%DATE%.RPT
"%BIN%¥GLY010.EXE" %DATE% > "%DATA%¥RPT¥GLY010.%DATE%.OUT" 2>&1
>>"%LOG%" echo GLY010 GLY010 %ERRORLEVEL%
if errorlevel 8 exit /b %ERRORLEVEL%

rem STEP GLY020: ご契約内容のお知らせ
set DD_COVMST=%DATA%¥MASTER¥COVMST.IDX
set DD_CSVTB=%DATA%¥MASTER¥CSVTB.TXT
set DD_NOTICE=%DATA%¥OUT¥NOTICE.%DATE%.TXT
"%BIN%¥GLY020.EXE" %DATE% > "%DATA%¥RPT¥GLY020.%DATE%.OUT" 2>&1
>>"%LOG%" echo GLY020 GLY020 %ERRORLEVEL%
if errorlevel 8 exit /b %ERRORLEVEL%

rem STEP GLD080: 日計表
set DD_GLD080R=%DATA%¥RPT¥GLD080.%DATE%.RPT
"%BIN%¥GLD080.EXE" %DATE% > "%DATA%¥RPT¥GLD080.%DATE%.OUT" 2>&1
>>"%LOG%" echo GLD080 GLD080 %ERRORLEVEL%
if errorlevel 8 exit /b %ERRORLEVEL%
exit /b 0
