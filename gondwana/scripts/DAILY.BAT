@echo off
rem DAILY.BAT: 日次処理。新契約の登録、契約応当日、給付支払、契約変更、
rem 失効、そしてアンロード。営業日ごとにスケジューラが起動する。
rem
rem 使い方: DAILY.BAT YYYYMMDD  業務日付
rem 環境: GLS_BIN プログラム、GLS_SCRIPTS バッチファイル、GLS_DATA データ
rem
rem 変更履歴
rem 1999-11-08 MS  GL-0233 初版、PC システム移行時 (旧 JCL から)。
rem 2003-10-06 MS  GL-0310 営業システムの新契約ファイル。
rem 2011-02-14 YN  GL-0520 契約変更に復活。
setlocal
set DATE=%1
set BIN=%GLS_BIN%
set DATA=%GLS_DATA%
set LOG=%DATA%¥LOG¥DAILY.%DATE%.LOG
set DD_POLMST=%DATA%¥MASTER¥POLMST.IDX
set DD_GLSCTL=%DATA%¥MASTER¥GLSCTL.BIN
set DD_PRODTB=%DATA%¥MASTER¥PRODTB.TXT
set DD_RATETB=%DATA%¥MASTER¥RATETB.TXT
set DD_CSVTB=%DATA%¥MASTER¥CSVTB.TXT
set DD_GLJRNL=%DATA%¥OUT¥GLJRNL.%DATE%.TXT
set DD_PAYOUT=%DATA%¥OUT¥PAYOUT.%DATE%.TXT

rem STEP GLD010: 新契約登録
set DD_NEWPOL=%DATA%¥IN¥NEWPOL.%DATE%.TXT
set DD_NEWREJ=%DATA%¥OUT¥NEWREJ.%DATE%.TXT
set DD_GLD010R=%DATA%¥RPT¥GLD010.%DATE%.RPT
"%BIN%¥GLD010.EXE" %DATE% > "%DATA%¥RPT¥GLD010.%DATE%.OUT" 2>&1
>>"%LOG%" echo GLD010 GLD010 %ERRORLEVEL%
if errorlevel 8 exit /b %ERRORLEVEL%

rem STEP GLD020: 契約応当日処理
set DD_GLD020R=%DATA%¥RPT¥GLD020.%DATE%.RPT
"%BIN%¥GLD020.EXE" %DATE% > "%DATA%¥RPT¥GLD020.%DATE%.OUT" 2>&1
>>"%LOG%" echo GLD020 GLD020 %ERRORLEVEL%
if errorlevel 8 exit /b %ERRORLEVEL%

rem STEP GLD030: 給付支払
set DD_CLMREQ=%DATA%¥IN¥CLMREQ.%DATE%.TXT
set DD_CLMREJ=%DATA%¥OUT¥CLMREJ.%DATE%.TXT
set DD_GLD030R=%DATA%¥RPT¥GLD030.%DATE%.RPT
"%BIN%¥GLD030.EXE" %DATE% > "%DATA%¥RPT¥GLD030.%DATE%.OUT" 2>&1
>>"%LOG%" echo GLD030 GLD030 %ERRORLEVEL%
if errorlevel 8 exit /b %ERRORLEVEL%

rem STEP GLD040: 契約変更
set DD_MNTREQ=%DATA%¥IN¥MNTREQ.%DATE%.TXT
set DD_MNTREJ=%DATA%¥OUT¥MNTREJ.%DATE%.TXT
set DD_GLD040R=%DATA%¥RPT¥GLD040.%DATE%.RPT
"%BIN%¥GLD040.EXE" %DATE% > "%DATA%¥RPT¥GLD040.%DATE%.OUT" 2>&1
>>"%LOG%" echo GLD040 GLD040 %ERRORLEVEL%
if errorlevel 8 exit /b %ERRORLEVEL%

rem STEP GLD060: 失効処理
set DD_GLD060R=%DATA%¥RPT¥GLD060.%DATE%.RPT
"%BIN%¥GLD060.EXE" %DATE% > "%DATA%¥RPT¥GLD060.%DATE%.OUT" 2>&1
>>"%LOG%" echo GLD060 GLD060 %ERRORLEVEL%
if errorlevel 8 exit /b %ERRORLEVEL%

rem STEP UNLOAD: 契約マスタのアンロードと制御レコードの更新
call "%GLS_SCRIPTS%¥UNLOAD.BAT" %DATE%
if errorlevel 8 exit /b %ERRORLEVEL%
exit /b 0
